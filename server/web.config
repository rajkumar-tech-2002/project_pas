<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- IIS → Node handler -->
    <handlers>
      <add name="iisnode" path="index.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>

        <!-- API requests go to Node -->
        <rule name="API" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="index.js" />
        </rule>

        <!-- Everything else (React routes) -->
        <rule name="ReactRoutes" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- IISNODE Configuration -->
    <iisnode
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxPendingRequestsPerProcess="1024"
      flushResponse="true"
      loggingEnabled="true"
      devErrorsEnabled="false"
      watchedFiles="web.config"
      gracefulShutdownTimeout="60000"
    />

    <!-- Disable IIS Caching Completely -->
    <caching enabled="false" enableKernelCache="false" />

    <!-- Disable Static Compression (optional but safer for APIs) -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <!-- No Cache Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>